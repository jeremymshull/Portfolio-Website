---
import ButtonLink from '../components/ButtonLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const homePath = import.meta.env.BASE_URL;
const projectsPath = `${homePath}projects/`;
---

<BaseLayout
  title="Page not found | Jeremy Shull"
  description="The requested page could not be found in Jeremy Shull's Salesforce portfolio."
  noIndex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="container not-found__inner">
      <p class="eyebrow">Error 404</p>
      <h1 id="not-found-title">This page could not be found.</h1>
      <p>The address may be incorrect, or the page may have moved.</p>
      <div class="button-group">
        <ButtonLink href={homePath}>Return home</ButtonLink>
        <ButtonLink href={projectsPath} variant="secondary">View projects</ButtonLink>
      </div>
    </div>
  </section>
</BaseLayout>
