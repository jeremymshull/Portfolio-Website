---
import { Image } from 'astro:assets';
import aboutImage from '../../source-assets/images/jeremy-shull-about.jpg';
import ButtonLink from '../components/ButtonLink.astro';
import PageHero from '../components/PageHero.astro';
import TagList from '../components/TagList.astro';
import { getPublishedSkills } from '../data/skills';
import { siteProfile } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const workingSkills = getPublishedSkills()
  .filter((skill) => skill.category === 'Business and Operations')
  .map((skill) => skill.name);
const contactPath = `${import.meta.env.BASE_URL}contact/`;
const resumePath = `${import.meta.env.BASE_URL}resume/Jeremy-Shull-Salesforce-Resume.pdf`;
---

<BaseLayout
  title="About Jeremy Shull | Salesforce portfolio"
  description="Jeremy Shull is a Salesforce Developer and Administrator focused on practical automation, Lightning experiences, integrations, and business processes."
>
  <PageHero
    eyebrow="About"
    title="Practical Salesforce systems."
    description="A concise view of my Salesforce focus, working approach, and current role preferences."
  />

  <section class="section section--surface" aria-labelledby="about-focus-title">
    <div class="container about-page__profile">
      <figure class="about-page__portrait">
        <Image
          src={aboutImage}
          alt="Jeremy Shull standing outdoors in warm evening light."
          widths={[480, 720, 960]}
          sizes="(min-width: 64rem) 38vw, 100vw"
          quality={84}
        />
      </figure>

      <div class="about-page__copy">
        <h2 id="about-focus-title">Building useful Salesforce systems.</h2>
        <p>{siteProfile.introduction}</p>
        <h3>Role focus</h3>
        <p>{siteProfile.targetRoles}</p>
        <div class="button-group">
          <ButtonLink href={contactPath}>Contact Jeremy</ButtonLink>
          <ButtonLink href={resumePath} variant="secondary" download="Jeremy-Shull-Salesforce-Resume.pdf">
            Download resume
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="working-approach-title">
    <div class="container about-page__details">
      <div>
        <h2 id="working-approach-title">Working approach</h2>
        <TagList items={workingSkills} label="Business and operations skills" />
      </div>

      <div>
        <h2>Location and availability</h2>
        <dl class="detail-list">
          <div><dt>Based in</dt><dd>{siteProfile.location}</dd></div>
          <div><dt>Role availability</dt><dd>{siteProfile.availability}</dd></div>
          <div><dt>Relocation</dt><dd>{siteProfile.relocation}</dd></div>
          <div><dt>Independent work</dt><dd>{siteProfile.consulting}</dd></div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
