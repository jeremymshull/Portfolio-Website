---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import TagList from './TagList.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  image?: ImageMetadata;
  prominent?: boolean;
}

const { project, image, prominent = false } = Astro.props;
const contextLabels = {
  personal: 'Personal project',
  training: 'Training project',
  volunteer: 'Volunteer project',
  professional: 'Professional project',
} as const;
const repository = project.data.links?.find((link) => link.kind === 'repository');
const media = project.data.media?.[0];
---

<article class:list={['project-card', prominent && 'project-card--prominent']}>
  {image && media && (
    <figure class="project-card__media">
      <Image
        src={image}
        alt={media.alt}
        widths={[480, 720, 960]}
        sizes="(min-width: 75rem) 42rem, (min-width: 48rem) 50vw, 100vw"
        loading={prominent ? 'eager' : 'lazy'}
        quality={82}
      />
      {media.caption && <figcaption>{media.caption}</figcaption>}
    </figure>
  )}

  <div class="project-card__body">
    <p class="project-card__context">{contextLabels[project.data.context!]}</p>
    <h3>{project.data.title}</h3>
    <p class="project-card__problem">
      <span>Business problem</span>
      {project.data.businessProblem}
    </p>
    <p class="project-card__solution">{project.data.solution}</p>
    <TagList items={project.data.technologies ?? []} label={`${project.data.title} technologies`} />

    {repository && (
      <a class="project-card__link" href={repository.url} target="_blank" rel="noreferrer noopener">
        View repository<span class="visually-hidden"> for {project.data.title}</span>
      </a>
    )}
  </div>
</article>
