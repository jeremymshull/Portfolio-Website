---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { ProjectTitleCard } from '../data/project-title-cards';
import Icon from './Icon.astro';
import TagList from './TagList.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  titleCard: ProjectTitleCard;
  prominent?: boolean;
}

const { project, titleCard, prominent = false } = Astro.props;
const contextLabels = {
  personal: 'Personal project',
  training: 'Training project',
  volunteer: 'Volunteer project',
  professional: 'Professional project',
} as const;
const caseStudyHref = `${import.meta.env.BASE_URL}projects/${project.id}/`;
---

<article
  class:list={[
    'project-card',
    prominent && 'project-card--prominent',
    project.id === 'case-intake-and-sla-automation' && 'project-card--case-intake',
  ]}
>
  <figure class="project-card__media">
    <Image
      src={titleCard.image}
      alt={titleCard.alt}
      widths={[480, 720, 960, 1440]}
      sizes="(min-width: 75rem) 42rem, (min-width: 48rem) 50vw, 100vw"
      loading={prominent ? 'eager' : 'lazy'}
      quality={82}
    />
  </figure>

  <div class="project-card__body">
    <p class="project-card__context">{contextLabels[project.data.context!]}</p>
    <h3><a class="project-card__title-link" href={caseStudyHref}>{project.data.title}</a></h3>
    <p class="project-card__problem">
      <span>Business problem</span>
      {project.data.cardProblem ?? project.data.businessProblem}
    </p>
    <p class="project-card__solution">{project.data.cardSolution ?? project.data.solution}</p>
    <TagList
      items={project.data.cardTechnologies ?? project.data.technologies ?? []}
      label={`${project.data.title} technologies`}
    />

    <span class="project-card__link" aria-hidden="true">
      View case study <Icon name="arrow-right" size="small" />
    </span>
  </div>
</article>
