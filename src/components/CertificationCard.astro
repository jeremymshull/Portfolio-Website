---
import type { Certification } from '../types/content';
import Icon from './Icon.astro';

interface Props {
  certification: Certification;
  headingLevel?: 2 | 3;
}

const { certification, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="certification-card">
  <p class="certification-card__issuer">{certification.issuer} certification</p>
  <Heading>{certification.name}</Heading>
  {certification.earnedDate && <p class="certification-card__date">Earned {certification.earnedDate}</p>}
  {certification.verificationUrl && (
    <a class="link-with-icon" href={certification.verificationUrl} target="_blank" rel="noreferrer noopener">
      Verify on Trailhead<span class="visually-hidden">: {certification.name}</span>
      <Icon name="arrow-square-out" size="small" />
    </a>
  )}
</article>
