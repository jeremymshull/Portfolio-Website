---
const homePath = import.meta.env.BASE_URL;
const navigation = [
  { label: 'Home', href: homePath, current: true },
  { label: 'Projects', href: `${homePath}#projects` },
  { label: 'Skills', href: `${homePath}#skills` },
  { label: 'Certifications', href: `${homePath}#certifications` },
  { label: 'About', href: `${homePath}#about` },
  { label: 'Contact', href: `${homePath}#contact` },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-brand" href={homePath} aria-label="Jeremy Shull portfolio home">
      <span class="site-brand__mark" aria-hidden="true">JS</span>
      <span>Jeremy Shull</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <ul>
          {navigation.map((item) => (
            <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu.removeAttribute('open'));
  });
</script>
