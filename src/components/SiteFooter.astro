---
import { siteProfile } from '../data/site';
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
const homePath = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <a class="site-footer__name" href={homePath}>Jeremy Shull</a>
      <p>Salesforce Developer and Administrator building practical platform solutions.</p>
    </div>
    <div class="site-footer__meta">
      <a class="link-with-icon" href={`mailto:${siteProfile.email}`}><Icon name="email" size="small" /> Email</a>
      <a class="link-with-icon" href={siteProfile.linkedin} target="_blank" rel="noreferrer noopener"><Icon name="linkedin" size="small" /> LinkedIn</a>
      <a class="link-with-icon" href={siteProfile.github} target="_blank" rel="noreferrer noopener"><Icon name="github" size="small" /> GitHub</a>
      <span>&copy; {currentYear}</span>
    </div>
  </div>
</footer>
