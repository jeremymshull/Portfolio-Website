---
import ButtonLink from './ButtonLink.astro';

interface Props {
  homePath: string;
}

const { homePath } = Astro.props;
const lines = ['404', 'Page not found'];
let characterIndex = 0;
---

<section class="error-game" data-falling-game aria-labelledby="error-game-title">
  <div class="container error-game__shell">
    <div class="error-game__intro">
      <div>
        <p class="eyebrow">Error 404</p>
        <p class="error-game__lede">The requested page is not here. Catch the message before it disappears.</p>
      </div>
      <ButtonLink href={homePath}>Return home</ButtonLink>
    </div>

    <div class="error-game__board" data-game-board>
      <h1 id="error-game-title" class="error-game__message" aria-label="404. Page not found.">
        {lines.map((line) => (
          <span class="error-game__line">
            {Array.from(line).map((character) => {
              if (character === ' ') return <span class="error-game__space" aria-hidden="true"> </span>;

              const index = characterIndex++;
              return <span class="error-game__letter" data-game-letter data-index={index} aria-hidden="true">{character}</span>;
            })}
          </span>
        ))}
      </h1>

      <div class="error-game__score" data-game-score aria-live="polite">Caught 0 of 15</div>

      <div
        class="error-game__catcher"
        data-game-catcher
        role="slider"
        tabindex="0"
        aria-label="Letter catcher horizontal position"
        aria-orientation="horizontal"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
      ><span class="visually-hidden">Move with Left and Right Arrow keys or A and D.</span></div>

      <div class="error-game__controls" data-game-controls aria-label="Catcher controls">
        <button type="button" data-move="left" aria-label="Move catcher left">Left</button>
        <p>Move with arrow keys or A and D</p>
        <button type="button" data-move="right" aria-label="Move catcher right">Right</button>
      </div>

      <div class="error-game__result" data-game-result hidden>
        <p class="eyebrow" data-game-result-label>Message recovered</p>
        <h2 data-game-result-title>Nice catch.</h2>
        <p data-game-result-copy></p>
        <div class="button-group">
          <button class="button" type="button" data-game-replay>Play again</button>
          <ButtonLink href={homePath} variant="secondary">Return home</ButtonLink>
        </div>
      </div>

      <p class="error-game__reduced-note" data-reduced-note hidden>
        Motion is reduced, so the 404 message will stay put.
      </p>
    </div>
  </div>
</section>

<script>
  type LetterState = {
    element: HTMLElement;
    startX: number;
    startY: number;
    width: number;
    height: number;
    delay: number;
    duration: number;
    drift: number;
    rotation: number;
    resolved: boolean;
  };

  const root = document.querySelector<HTMLElement>('[data-falling-game]');

  if (root) {
    const board = root.querySelector<HTMLElement>('[data-game-board]');
    const catcher = root.querySelector<HTMLElement>('[data-game-catcher]');
    const score = root.querySelector<HTMLElement>('[data-game-score]');
    const controls = root.querySelector<HTMLElement>('[data-game-controls]');
    const result = root.querySelector<HTMLElement>('[data-game-result]');
    const resultLabel = root.querySelector<HTMLElement>('[data-game-result-label]');
    const resultTitle = root.querySelector<HTMLElement>('[data-game-result-title]');
    const resultCopy = root.querySelector<HTMLElement>('[data-game-result-copy]');
    const replay = root.querySelector<HTMLButtonElement>('[data-game-replay]');
    const reducedNote = root.querySelector<HTMLElement>('[data-reduced-note]');
    const letters = Array.from(root.querySelectorAll<HTMLElement>('[data-game-letter]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pressedDirections = new Set<'left' | 'right'>();
    const abortController = new AbortController();
    const { signal } = abortController;
    let letterStates: LetterState[] = [];
    let catcherX = 0;
    let caught = 0;
    let resolved = 0;
    let startTime = 0;
    let previousTime = 0;
    let animationFrame = 0;
    let startTimer = 0;
    let playing = false;
    let dragging = false;

    const isInteractiveTarget = (target: EventTarget | null) =>
      target instanceof Element && Boolean(target.closest('a, button, input, textarea, select, [contenteditable]'));

    const boardWidth = () => board?.clientWidth ?? 0;
    const catcherWidth = () => catcher?.offsetWidth ?? 0;

    const updateCatcher = (nextX: number) => {
      if (!catcher) return;

      catcherX = Math.max(0, Math.min(nextX, boardWidth() - catcherWidth()));
      catcher.style.transform = `translate3d(${catcherX}px, 0, 0)`;
      const percentage = boardWidth() > catcherWidth()
        ? Math.round((catcherX / (boardWidth() - catcherWidth())) * 100)
        : 50;
      catcher.setAttribute('aria-valuenow', String(percentage));
    };

    const updateScore = () => {
      if (score) score.textContent = `Caught ${caught} of ${letters.length}`;
    };

    const clearLetterStyles = () => {
      letters.forEach((letter) => {
        letter.removeAttribute('style');
        letter.removeAttribute('data-outcome');
      });
    };

    const finishGame = () => {
      playing = false;
      pressedDirections.clear();
      root.classList.remove('is-playing');
      root.classList.add('is-complete');

      if (!result || !resultLabel || !resultTitle || !resultCopy) return;

      const perfect = caught === letters.length;
      resultLabel.textContent = perfect ? 'Perfect catch' : 'Message recovered';
      resultTitle.textContent = perfect ? 'Nothing got past you.' : 'Nice catch.';
      resultCopy.textContent = perfect
        ? `You caught all ${letters.length} characters.`
        : `You caught ${caught} of ${letters.length} characters.`;
      result.hidden = false;
      replay?.focus({ preventScroll: true });
    };

    const resolveLetter = (state: LetterState, outcome: 'caught' | 'missed') => {
      if (state.resolved) return;

      state.resolved = true;
      resolved += 1;
      state.element.dataset.outcome = outcome;

      if (outcome === 'caught') {
        caught += 1;
        catcher?.classList.remove('is-catching');
        requestAnimationFrame(() => catcher?.classList.add('is-catching'));
      }

      updateScore();
      if (resolved === letters.length) finishGame();
    };

    const animate = (time: number) => {
      if (!playing || !board || !catcher) return;

      const deltaSeconds = Math.min((time - previousTime) / 1000, 0.05);
      previousTime = time;
      const direction = Number(pressedDirections.has('right')) - Number(pressedDirections.has('left'));
      if (direction) updateCatcher(catcherX + direction * 430 * deltaSeconds);

      const elapsed = time - startTime;
      const catcherTop = board.clientHeight - catcher.offsetHeight - 70;
      const catcherBottom = catcherTop + catcher.offsetHeight;

      letterStates.forEach((state) => {
        if (state.resolved || elapsed < state.delay) return;

        const progress = Math.min((elapsed - state.delay) / state.duration, 1);
        const fallDistance = board.clientHeight - state.startY + state.height;
        const y = fallDistance * progress * progress;
        const x = state.drift * Math.sin(progress * Math.PI);
        const currentLeft = state.startX + x;
        const currentTop = state.startY + y;
        state.element.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${state.rotation * progress}deg)`;

        const overlapsCatcher =
          currentTop + state.height >= catcherTop &&
          currentTop <= catcherBottom &&
          currentLeft + state.width >= catcherX &&
          currentLeft <= catcherX + catcher.offsetWidth;

        if (overlapsCatcher) {
          resolveLetter(state, 'caught');
        } else if (progress === 1) {
          resolveLetter(state, 'missed');
        }
      });

      if (playing) animationFrame = requestAnimationFrame(animate);
    };

    const startGame = () => {
      if (!board || !catcher || reduceMotion) return;

      cancelAnimationFrame(animationFrame);
      clearTimeout(startTimer);
      clearLetterStyles();
      root.classList.remove('is-complete', 'is-playing');
      if (result) result.hidden = true;
      caught = 0;
      resolved = 0;
      updateScore();
      updateCatcher((board.clientWidth - catcher.offsetWidth) / 2);

      const boardRect = board.getBoundingClientRect();
      letterStates = letters.map((element, index) => {
        const rect = element.getBoundingClientRect();
        const state = {
          element,
          startX: rect.left - boardRect.left,
          startY: rect.top - boardRect.top,
          width: rect.width,
          height: rect.height,
          delay: index * 190 + (index % 3) * 70,
          duration: 4700 + (index % 5) * 390,
          drift: ((index % 5) - 2) * 16,
          rotation: ((index % 7) - 3) * 9,
          resolved: false,
        };

        element.style.width = `${rect.width}px`;
        element.style.height = `${rect.height}px`;
        element.style.left = `${state.startX}px`;
        element.style.top = `${state.startY}px`;
        return state;
      });

      root.classList.add('is-playing');
      playing = true;
      startTime = performance.now();
      previousTime = startTime;
      animationFrame = requestAnimationFrame(animate);
    };

    const queueGame = () => {
      if (reduceMotion) return;
      startTimer = window.setTimeout(startGame, 1450);
    };

    const directionFromKey = (key: string): 'left' | 'right' | undefined => {
      const normalized = key.toLowerCase();
      if (normalized === 'arrowleft' || normalized === 'a') return 'left';
      if (normalized === 'arrowright' || normalized === 'd') return 'right';
      return undefined;
    };

    document.addEventListener('keydown', (event) => {
      const direction = directionFromKey(event.key);
      if (!playing || !direction || isInteractiveTarget(event.target)) return;
      event.preventDefault();
      if (!event.repeat) updateCatcher(catcherX + (direction === 'right' ? 32 : -32));
      pressedDirections.add(direction);
    }, { signal });

    document.addEventListener('keyup', (event) => {
      const direction = directionFromKey(event.key);
      if (direction) pressedDirections.delete(direction);
    }, { signal });

    controls?.querySelectorAll<HTMLButtonElement>('[data-move]').forEach((button) => {
      const direction = button.dataset.move as 'left' | 'right';
      const stop = () => pressedDirections.delete(direction);

      button.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        pressedDirections.add(direction);
        button.setPointerCapture(event.pointerId);
      }, { signal });
      button.addEventListener('pointerup', stop, { signal });
      button.addEventListener('pointercancel', stop, { signal });
      button.addEventListener('lostpointercapture', stop, { signal });
      button.addEventListener('click', () => {
        if (playing) updateCatcher(catcherX + (direction === 'right' ? 56 : -56));
      }, { signal });
    });

    catcher?.addEventListener('pointerdown', (event) => {
      if (!playing) return;
      dragging = true;
      catcher.setPointerCapture(event.pointerId);
    }, { signal });

    catcher?.addEventListener('pointermove', (event) => {
      if (!dragging || !board || !catcher) return;
      const rect = board.getBoundingClientRect();
      updateCatcher(event.clientX - rect.left - catcher.offsetWidth / 2);
    }, { signal });

    const stopDragging = () => { dragging = false; };
    catcher?.addEventListener('pointerup', stopDragging, { signal });
    catcher?.addEventListener('pointercancel', stopDragging, { signal });
    catcher?.addEventListener('lostpointercapture', stopDragging, { signal });

    replay?.addEventListener('click', () => {
      clearLetterStyles();
      root.classList.remove('is-complete');
      if (result) result.hidden = true;
      requestAnimationFrame(startGame);
    }, { signal });

    window.addEventListener('resize', () => {
      if (!playing && board && catcher) updateCatcher((board.clientWidth - catcher.offsetWidth) / 2);
    }, { signal });

    window.addEventListener('pagehide', () => {
      clearTimeout(startTimer);
      cancelAnimationFrame(animationFrame);
      abortController.abort();
    }, { once: true });

    if (reduceMotion) {
      root.classList.add('is-reduced-motion');
      if (reducedNote) reducedNote.hidden = false;
    } else {
      requestAnimationFrame(() => {
        if (board && catcher) updateCatcher((board.clientWidth - catcher.offsetWidth) / 2);
        queueGame();
      });
    }
  }
</script>

<style>
  .error-game {
    padding-block: clamp(var(--space-8), 6vw, var(--space-16));
  }

  .error-game__shell {
    display: grid;
    gap: var(--space-6);
  }

  .error-game__intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .error-game__intro .eyebrow {
    margin-bottom: var(--space-2);
  }

  .error-game__intro :global(.button-link) {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .error-game__lede {
    max-width: 46rem;
    margin: 0;
    color: var(--color-text-secondary);
  }

  .error-game__board {
    position: relative;
    min-height: clamp(31rem, 68dvh, 43rem);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background:
      linear-gradient(90deg, transparent calc(50% - 0.5px), rgb(157 188 124 / 0.08) 50%, transparent calc(50% + 0.5px)),
      var(--color-surface);
  }

  .error-game__board::before {
    position: absolute;
    inset: var(--space-4);
    border: 1px solid rgb(157 188 124 / 0.14);
    border-radius: var(--radius-medium);
    content: '';
    pointer-events: none;
  }

  .error-game__message {
    position: absolute;
    z-index: 2;
    top: clamp(var(--space-8), 7vw, var(--space-16));
    left: clamp(var(--space-6), 7vw, var(--space-16));
    max-width: none;
    margin: 0;
    font-size: clamp(3rem, 10vw, 8.5rem);
    line-height: 0.88;
    pointer-events: none;
  }

  .error-game__line {
    display: block;
    white-space: nowrap;
  }

  .error-game__line:first-child {
    color: var(--color-accent-light);
    font-family: var(--font-mono);
    font-size: 0.62em;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .error-game__letter,
  .error-game__space {
    display: inline-block;
  }

  .error-game__space {
    width: 0.24em;
  }

  .error-game__letter {
    will-change: transform;
  }

  .is-playing .error-game__letter {
    position: absolute;
  }

  .is-playing .error-game__message {
    position: static;
  }

  .error-game__letter[data-outcome] {
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .error-game__score {
    position: absolute;
    z-index: 3;
    top: var(--space-4);
    right: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: rgb(13 17 23 / 0.84);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .error-game__catcher {
    position: absolute;
    z-index: 3;
    bottom: 4.375rem;
    left: 0;
    width: clamp(5.5rem, 10vw, 7.5rem);
    height: 2.75rem;
    cursor: grab;
    touch-action: none;
    will-change: transform;
  }

  .error-game__catcher::before {
    position: absolute;
    inset: auto 0 0;
    height: 1.75rem;
    border: 2px solid var(--color-accent-light);
    border-top: 0;
    border-radius: 0 0 var(--radius-medium) var(--radius-medium);
    background: rgb(157 188 124 / 0.08);
    content: '';
    transition: border-color var(--duration-fast) var(--ease-standard), background var(--duration-fast) var(--ease-standard);
  }

  .error-game__catcher:active { cursor: grabbing; }

  .error-game__catcher.is-catching::before {
    border-color: var(--color-text);
    background: rgb(209 231 181 / 0.18);
  }

  .error-game__controls {
    position: absolute;
    z-index: 4;
    right: var(--space-4);
    bottom: var(--space-4);
    left: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  .error-game__controls p {
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .error-game__controls button,
  .error-game__result .button {
    min-width: 3.25rem;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface-elevated);
    color: var(--color-text);
    font: 700 0.875rem/1 var(--font-body);
    cursor: pointer;
  }

  .error-game__result {
    position: absolute;
    z-index: 5;
    inset: 50% auto auto 50%;
    width: min(calc(100% - 3rem), 34rem);
    padding: clamp(var(--space-6), 5vw, var(--space-8));
    translate: -50% -50%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: rgb(13 17 23 / 0.96);
  }

  .error-game__result h2 {
    margin-bottom: var(--space-3);
    font-size: clamp(2rem, 6vw, 3.5rem);
  }

  .error-game__result p:not(.eyebrow) {
    color: var(--color-text-secondary);
  }

  .error-game__result .button-group {
    margin-top: var(--space-6);
  }

  .error-game__reduced-note {
    position: absolute;
    right: var(--space-6);
    bottom: var(--space-6);
    left: var(--space-6);
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-align: center;
  }

  .is-complete .error-game__catcher,
  .is-complete .error-game__controls {
    opacity: 0;
    pointer-events: none;
  }

  .is-reduced-motion .error-game__score,
  .is-reduced-motion .error-game__catcher,
  .is-reduced-motion .error-game__controls {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .error-game__intro {
      align-items: start;
      flex-direction: column;
    }

    .error-game__board {
      min-height: 32rem;
    }

    .error-game__message {
      top: var(--space-12);
      left: var(--space-6);
      font-size: clamp(2.3rem, 9.5vw, 4.25rem);
    }

    .error-game__controls p {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .error-game__controls {
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .error-game__letter,
    .error-game__catcher {
      transition: none;
      will-change: auto;
    }
  }
</style>
