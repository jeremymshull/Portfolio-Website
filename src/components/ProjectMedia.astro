---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  caption?: string;
  unavailableReason?: string;
}

const { image, alt = '', caption, unavailableReason } = Astro.props;
---

{image ? (
  <figure class="case-study__media">
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 90rem) 80rem, calc(100vw - 3rem)"
      quality={84}
    />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
) : (
  <aside class="case-study__media-empty" aria-label="Project media availability">
    <p class="eyebrow">Project media</p>
    <p>{unavailableReason ?? 'No verified public project image is available.'}</p>
  </aside>
)}
