---
import { getImage } from 'astro:assets';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/syne';
import socialShareSource from '../../source-assets/images/jeremy-shull-salesforce-title-card.png';
import KonamiListener from '../components/KonamiListener.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteProfile } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const faviconPath = `${import.meta.env.BASE_URL}favicon.svg`;
const socialShareImage = await getImage({
  src: socialShareSource,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'webp',
  quality: 84,
});
const socialSharePath = socialShareImage.src;
const socialShareUrl = Astro.site ? new URL(socialSharePath, Astro.site) : undefined;
const structuredData = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      '@id': new URL(`${import.meta.env.BASE_URL}#jeremy-shull`, Astro.site).href,
      name: 'Jeremy Shull',
      jobTitle: 'Salesforce Developer and Administrator',
      url: new URL(import.meta.env.BASE_URL, Astro.site).href,
      email: `mailto:${siteProfile.email}`,
      sameAs: [siteProfile.linkedin, siteProfile.github, siteProfile.trailhead],
    }
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow'} />
    <link rel="icon" type="image/svg+xml" href={faviconPath} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jeremy Shull Salesforce portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialShareUrl && <meta property="og:image" content={socialShareUrl} />}
    {socialShareUrl && <meta property="og:image:width" content="1200" />}
    {socialShareUrl && <meta property="og:image:height" content="630" />}
    {socialShareUrl && <meta property="og:image:alt" content="Jeremy Shull, Salesforce Developer and Administrator." />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialShareUrl && <meta name="twitter:image" content={socialShareUrl} />}
    {socialShareUrl && <meta name="twitter:image:alt" content="Jeremy Shull, Salesforce Developer and Administrator." />}
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content"><slot /></main>
    <SiteFooter />
    <KonamiListener />
  </body>
</html>
